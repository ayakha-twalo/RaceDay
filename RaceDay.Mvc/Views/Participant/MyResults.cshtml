@using RaceDay.Contracts.DTOs.Results
@model List<ResultResponseDto>
@{
    ViewData["Title"] = "My results";
}

@functions {
    // 1 -> "1st", 2 -> "2nd", 11 -> "11th", 23 -> "23rd" ...
    static string Ordinal(int n)
    {
        if (n % 100 is 11 or 12 or 13) return n + "th";

        return (n % 10) switch
        {
            1 => n + "st",
            2 => n + "nd",
            3 => n + "rd",
            _ => n + "th"
        };
    }

    // Gold, silver and bronze for the top three.
    static string PositionClass(int n) => n switch
    {
        1 => "position-gold",
        2 => "position-silver",
        3 => "position-bronze",
        _ => "position-other"
    };
}

<h1 class="mb-3">My results</h1>

@if (!Model.Any())
{
    <div class="rd-card p-4 text-center">
        <p class="mb-0">No results yet. Once an organiser records your finish time it will appear here.</p>
    </div>
}
else
{
    <div class="rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.EventName</td>
                            <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@r.CategoryName</td>
                            <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                            <td><span class="position-badge @PositionClass(r.FinishPosition)">@Ordinal(r.FinishPosition)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}