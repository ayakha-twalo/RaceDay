@model List<MyEventRowVm>
@{
    ViewData["Title"] = "My events";
}

@functions {
    static string BadgeClass(string status) => status switch
    {
        "Confirmed" => "status-confirmed",
        "Pending" => "status-pending",
        _ => "status-cancelled"
    };
}

<h1 class="mb-3">My events</h1>

@if (!Model.Any())
{
    <div class="rd-card p-4 text-center">
        <p class="mb-3">You have not entered any events yet.</p>
        <a class="btn btn-primary" asp-action="Index">Browse upcoming events</a>
    </div>
}
else
{
    <div class="rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@row.EventId">@row.EventName</a>
                            </td>
                            <td>@(row.EventDate?.ToString("dd MMM yyyy"))</td>
                            <td>@row.Location</td>
                            <td>@row.CategoryName</td>
                            <td><span class="status-badge @BadgeClass(row.Status)">@row.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}