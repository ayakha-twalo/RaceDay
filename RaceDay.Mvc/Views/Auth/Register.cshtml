@model RegisterVm
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="rd-card p-4">
            <h1 class="mb-3">Create your account</h1>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">I am registering as</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Participant">Participant (enter events)</option>
                        <option value="Organiser">Organiser (run events)</option>
                    </select>
                </div>

                @* Only shown when Organiser is selected (see script below). *@
                <div id="organiserCodeGroup" class="mb-3 @(Model.Role == UserRoles.Organiser ? "" : "d-none")">
                    <label asp-for="OrganiserCode" class="form-label"></label>
                    <input asp-for="OrganiserCode" class="form-control" />
                    <span asp-validation-for="OrganiserCode" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Register</button>
            </form>

            <p class="text-center mt-3 mb-0">
                Already have an account? <a asp-action="Login">Log in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the invite-code box only for Organisers.
        const roleSelect = document.getElementById('Role');
        const codeGroup = document.getElementById('organiserCodeGroup');
        roleSelect.addEventListener('change', () => {
            codeGroup.classList.toggle('d-none', roleSelect.value !== 'Organiser');
        });
    </script>
}