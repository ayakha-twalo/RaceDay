@model EventPickerVm
@{
    // Submit the drop-down back to whichever page we are on.
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

@if (!Model.MyEvents.Any())
{
    <div class="rd-card p-4 text-center">
        <p class="mb-3">You need to create an event first.</p>
        <a class="btn btn-primary" asp-action="CreateEvent">Create an event</a>
    </div>
}
else
{
    <form asp-action="@currentAction" method="get"
          class="rd-card p-3 mb-4 d-flex flex-wrap align-items-center gap-3">
        <label for="eventId" class="fw-semibold mb-0">Event</label>
        <select id="eventId" name="eventId" class="form-select w-auto" onchange="this.form.submit()">
            @foreach (var e in Model.MyEvents)
            {
                <option value="@e.EventId" selected="@(e.EventId == Model.SelectedEventId)">
                    @e.EventName (@e.EventDate.ToString("dd MMM yyyy"))
                </option>
            }
        </select>
        <noscript><button type="submit" class="btn btn-primary">Show</button></noscript>
    </form>
}