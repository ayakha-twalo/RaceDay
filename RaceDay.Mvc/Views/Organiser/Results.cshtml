@model ResultsPageVm
@{
    ViewData["Title"] = "Results";
}

<h1 class="mb-3">Results</h1>

<partial name="_EventPicker" model="Model" />

@if (Model.SelectedEventId != null)
{
    <div class="rd-card p-4">
        <h2 class="h4">Results for @Model.SelectedEventName</h2>

        @if (!Model.Rows.Any())
        {
            <p class="text-muted mb-0">There are no active enrolments to record results for yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Finish time and position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="fw-semibold">@row.ParticipantName</td>
                                <td>@row.CategoryName</td>
                                <td>
                                    @if (row.HasResult)
                                    {
                                        <span class="status-badge status-confirmed">Recorded</span>
                                        <span class="ms-2 fw-semibold">@(row.FinishTime!.Value.ToString(@"hh\:mm\:ss"))</span>
                                        <span class="text-muted">&middot; position @row.FinishPosition</span>
                                    }
                                    else
                                    {
                                        <form asp-action="CaptureResult" method="post"
                                              class="d-flex flex-wrap gap-2 align-items-center">
                                            <input type="hidden" name="EnrolmentId" value="@row.EnrolmentId" />
                                            <input type="hidden" name="EventId" value="@Model.SelectedEventId" />

                                            <input type="text" name="FinishTime" class="form-control form-control-sm"
                                                   style="width:110px" placeholder="00:45:30"
                                                   pattern="\d{1,2}:[0-5]\d:[0-5]\d"
                                                   title="Enter hh:mm:ss, for example 00:45:30" required />

                                            <input type="number" name="FinishPosition" class="form-control form-control-sm"
                                                   style="width:90px" placeholder="Pos." min="1" required />

                                            <button type="submit" class="btn btn-sm btn-primary">Save result</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}