@model EventFormVm
@{
    ViewData["Title"] = "Edit event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-card p-4">
            <h1 class="mb-3">Edit event</h1>
            <partial name="_EventForm" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<hr class="my-4" />

<div class="rd-card p-4">
    <h2 class="h4 mb-3">Event banner</h2>

    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <p>Current event banner:</p>

        <img src="@Model.BannerImageUrl"
             alt="Event banner"
             class="img-fluid rounded mb-3"
             style="max-height: 250px; width: 100%; object-fit: cover;" />
    }
    else
    {
        <p class="text-muted">No banner has been uploaded yet.</p>
    }

    <form asp-action="UploadBanner"
          asp-route-id="@Model.EventId"
          method="post"
          enctype="multipart/form-data">

        <div class="mb-3">
            <label for="file" class="form-label">
                Select an event banner
            </label>

            <input type="file"
                   id="file"
                   name="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.gif,.webp"
                   required />
        </div>

        <small class="text-muted d-block mb-3">
            Accepted formats: JPG, JPEG, PNG, GIF and WEBP.
            Maximum size: 5 MB.
        </small>

        <button type="submit" class="btn btn-primary">
            Upload banner
        </button>
    </form>
</div>