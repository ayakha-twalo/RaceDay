@model OrganiserDashboardVm
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Dashboard</h1>
    <a class="btn btn-primary" asp-action="CreateEvent">+ New event</a>
</div>

@* Summary numbers *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="rd-card p-3 text-center">
            <div class="rd-stat">@Model.TotalEvents</div>
            <div class="text-muted">Events created</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-card p-3 text-center">
            <div class="rd-stat">@Model.UpcomingEvents</div>
            <div class="text-muted">Upcoming events</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-card p-3 text-center">
            <div class="rd-stat">@Model.TotalEnrolments</div>
            <div class="text-muted">Total enrolments</div>
        </div>
    </div>
</div>

@if (!Model.Events.Any())
{
    <div class="rd-card p-4 text-center">
        <p class="mb-3">You have not created any events yet.</p>
        <a class="btn btn-primary" asp-action="CreateEvent">Create your first event</a>
    </div>
}
else
{
    <div class="rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th class="text-center">Enrolments</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Events)
                    {
                        <tr>
                            <td class="fw-semibold">@e.EventName</td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@e.Location</td>
                            <td class="text-center">@e.EnrolmentCount</td>
                            <td>
                                @if (e.IsUpcoming)
                                {
                                    <span class="status-badge status-confirmed">Upcoming</span>
                                }
                                else
                                {
                                    <span class="status-badge status-cancelled">Completed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}